{
  "name": "@jm/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/api/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/api/start.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker/main.ts",
    "pipeline": "tsx --env-file-if-exists=../../.env src/worker/cli.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/cli.ts seed",
    "db:export": "tsx --env-file-if-exists=../../.env src/db/cli.ts export-clean",
    "db:push": "tsx --env-file-if-exists=../../.env src/db/cli.ts push-remote",
    "db:merge-vitrine": "tsx --env-file-if-exists=../../.env src/db/merge-cli.ts",
    "db:backup": "tsx --env-file-if-exists=../../.env src/db/cli.ts backup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "ai": "tsx --env-file-if-exists=../../.env src/ai/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@jm/contracts": "*",
    "fast-xml-parser": "5.12.1",
    "fastify": "5.12.8",
    "libsql": "^0.5.29",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}
