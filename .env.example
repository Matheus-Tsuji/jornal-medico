# Copie para .env. Nunca commite o .env. Segredos só no servidor (nada com prefixo VITE_).
NODE_ENV=development
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=file:./data/journal.db
APP_TIMEZONE=America/Sao_Paulo
EDITION_HOUR=06:00
BRAND_NAME=Jornal Médico

# Sessão (obrigatório em produção, >= 32 caracteres aleatórios)
SESSION_SECRET=
SESSION_DAYS=30
# E-mails que viram admin ao entrar (separados por vírgula)
ADMIN_EMAILS=

# E-mail transacional: console (caixa postal local, só dev) | resend
AUTH_EMAIL_PROVIDER=console
AUTH_EMAIL_API_KEY=
AUTH_EMAIL_FROM=

# OpenAI (análise só roda com chave + modelos do catálogo do seu projeto)
OPENAI_API_KEY=
OPENAI_TRIAGE_MODEL=
OPENAI_ANALYSIS_MODEL=
OPENAI_EDITORIAL_MODEL=
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=
AI_MAX_ARTICLES_PER_DAY=20
AI_MAX_OUTPUT_TOKENS=6000

# PubMed / NCBI E-utilities (sem chave: até 3 req/s)
NCBI_API_KEY=
NCBI_TOOL=jornal_medico
NCBI_CONTACT_EMAIL=
INGEST_MAX_PER_TOPIC=20
INGEST_OVERLAP_DAYS=3

# Pagamentos (só sandbox no MVP)
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=
PAYWALL_ENABLED=false
BILLING_GRACE_DAYS=3

# Recomendador Python opcional (python services/recommender/serve.py)
RECOMMENDER_URL=
RANKING_MIN_READERS=3

# Flags iniciais (depois do primeiro seed, use o painel /admin)
FEATURE_REAL_CONTENT=false
FEATURE_NOTION=false
FEATURE_CLICKUP=false
FEATURE_AUDIO=false
FEATURE_VIDEO=false
FEATURE_PWA=false
